# ============================================================================
# Real-Time RAG Voice Assistant — environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# ============================================================================

# ---------------------------------------------------------------- application
APP_ENV=development                 # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APP_LOG_JSON=false                  # true in production
APP_RELOAD=true
APP_WORKERS=1
# Comma-separated. Use explicit origins in production, never "*" with credentials.
APP_CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ------------------------------------------------------------------ llm layer
# provider: groq | openai | gemini
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=400
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------- embeddings
# provider: fastembed (local ONNX, no API key, fastest cold path)
#         | openai
#         | sentence_transformers
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64

# -------------------------------------------------------------- vector store
# provider: chroma | pinecone | memory
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_COLLECTION=voice_kb
VECTOR_STORE_PATH=./data/vector_store

PINECONE_API_KEY=
PINECONE_INDEX=voice-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------------------------------------------------------------------- rag
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_FETCH_K=16                      # candidates pulled before MMR / reranking
# Cosine-similarity floor, 0..1. This is MODEL-DEPENDENT and worth tuning: bge/e5
# models rarely score English text below ~0.65, so a low floor filters nothing.
# 0.75 suits bge-small; OpenAI text-embedding-3 sits lower, try ~0.35.
# Use the "Retrieval inspector" tab (or POST /api/v1/rag/retrieve) to pick yours.
# If every candidate is filtered out, the best single hit is kept anyway, so a
# high floor reduces noise rather than silencing the assistant.
RAG_MIN_RELEVANCE_SCORE=0.75
RAG_USE_MMR=true
RAG_MMR_LAMBDA=0.6                  # 1.0 = pure relevance, 0.0 = pure diversity
RAG_MAX_CONTEXT_CHARS=6000
RAG_HISTORY_TURNS=6
RAG_QUERY_CACHE_SIZE=512
RAG_QUERY_CACHE_TTL_SECONDS=300
RAG_DOCUMENTS_DIR=./data/documents

# ---------------------------------------------------------------------- vapi
VAPI_API_KEY=                       # private key, server-side only
VAPI_PUBLIC_KEY=                    # safe to expose to browsers / web SDK
VAPI_ASSISTANT_ID=
# Shared secret Vapi sends back as `x-vapi-secret`; requests without it are rejected.
VAPI_WEBHOOK_SECRET=
VAPI_VOICE_PROVIDER=11labs
VAPI_VOICE_ID=burt
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-3
# Generic English. Regional variants are separately tuned and usually beat "en"
# for a matching speaker: en-IN (South Asian), en-GB, en-AU, en-US.
VAPI_TRANSCRIBER_LANGUAGE=en
# Comma-separated names/jargon to boost. Anything the transcriber has no reason
# to know -- people, products, frameworks -- belongs here, or it comes back as
# noise. Put your own document's proper nouns in. Keep it under ~50 terms.
VAPI_TRANSCRIBER_KEYTERMS=
# Deepgram discards words below this confidence (0..1). The 0.4 default silently
# drops accented speech; lower to ~0.25 if words go missing entirely.
VAPI_TRANSCRIBER_CONFIDENCE_THRESHOLD=0.4
VAPI_SERVER_URL=                    # public HTTPS base URL (e.g. ngrok tunnel)

# ------------------------------------------------------------------ security
# Comma-separated bearer tokens accepted on protected routes. Empty = auth off.
API_KEYS=
RATE_LIMIT_PER_MINUTE=120
